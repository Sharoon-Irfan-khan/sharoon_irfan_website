# Contact form delivery (Resend — https://resend.com)
# Without RESEND_API_KEY the form tells visitors to email hello@sharoon.ae instead.
RESEND_API_KEY=

# Where enquiries land. Defaults to hello@sharoon.ae.
CONTACT_TO=hello@sharoon.ae

# The "from" address. Must be a domain verified in Resend.
# Until sharoon.ae is verified there, leave this unset to use Resend's sandbox sender.
CONTACT_FROM=Sharoon Irfan Website <website@sharoon.ae>

# ---- The Thought Room (Sanity) ----
# The team's Sanity project, where the blog is written. Both values are filled
# in rather than left blank, because neither is a secret: they are NEXT_PUBLIC_
# and ship inside the browser bundle on every page load, so a reader can already
# see them with view-source. Publishing them here only saves the next person a
# trip to sanity.io/manage.
#
# The same two must be set in Vercel (Settings -> Environment Variables) for the
# deployed site. Without the project id the page still builds — it renders an
# empty state rather than failing.
NEXT_PUBLIC_SANITY_PROJECT_ID=0z2uy7z3
NEXT_PUBLIC_SANITY_DATASET=production

# This one IS a secret and stays empty here. Only needed if the dataset is made
# private, or to preview unpublished drafts. Server-side only — never prefix it
# with NEXT_PUBLIC_, which would publish it to every visitor.
SANITY_API_READ_TOKEN=
