# ---- Contact form delivery (SMTP) ----
# Enquiries from the form are emailed to info@sharoon.ae over SMTP, using the
# mailbox's own credentials. Until SMTP_HOST, SMTP_USER and SMTP_PASS are all
# set, the form tells visitors to write to info@sharoon.ae directly instead of
# pretending the message was delivered.
#
# Set up to send through Gmail. Other providers, if this ever moves:
#   Google / Gmail      smtp.gmail.com         465
#   Microsoft 365       smtp.office365.com     587
#   Zoho Mail           smtp.zoho.com          465
#   cPanel / shared     mail.sharoon.ae        465
#
# Port 465 is implicit TLS and 587 is STARTTLS; the code picks the right mode
# from the port, so set the port your provider documents and nothing else.
#
# SMTP_USER is the mailbox that SENDS. It does not have to be — and here is not —
# the mailbox that receives; see CONTACT_TO below. This is simply the account
# whose password is available.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sharoonirfan.ae@gmail.com

# A Google APP PASSWORD — 16 characters, generated at
# https://myaccount.google.com/apppasswords — NOT the account's normal login
# password. Google stopped accepting the login password from third-party apps in
# 2022, so nothing else will authenticate. The page only appears once 2-Step
# Verification is switched on for the account.
#
# Paste it with or without the spaces Google shows; both work.
#
# Keep this out of git — it lives in .env.local locally and in Vercel's
# environment variables in production.
SMTP_PASS=

# Where enquiries LAND. Independent of SMTP_USER — the mailbox that sends does
# not have to be the mailbox that reads. Set this to whatever you actually open.
#
# Takes a comma-separated list, so an enquiry can reach two inboxes at once —
# which is what to do the day info@sharoon.ae becomes available:
#   CONTACT_TO=sharoonirfan.ae@gmail.com, info@sharoon.ae
#
# Defaults to info@sharoon.ae, so set it explicitly while that mailbox cannot be
# opened or the enquiries go somewhere nobody is reading.
CONTACT_TO=sharoonirfan.ae@gmail.com

# The "from" address on the enquiry email.
#
# LEAVE THIS UNSET unless you know you need it. It defaults to SMTP_USER, which
# is the one value guaranteed to work: a mailbox may only send as itself unless
# the provider has been told otherwise, and setting up a "send as" alias on
# Google Workspace or Microsoft 365 requires access to the address being claimed.
# Point it at an address you cannot log into and the provider rejects the send.
#
# It is deliberately never the visitor's address: sending as them would fail SPF
# and DMARC and land the message in spam. Their address goes in Reply-To
# instead, so pressing reply still writes back to them.
CONTACT_FROM=

# ---- The Thought Room (Sanity) ----
# The team's Sanity project, where the blog is written. Both values are filled
# in rather than left blank, because neither is a secret: they are NEXT_PUBLIC_
# and ship inside the browser bundle on every page load, so a reader can already
# see them with view-source. Publishing them here only saves the next person a
# trip to sanity.io/manage.
#
# The same two must be set in Vercel (Settings -> Environment Variables) for the
# deployed site. Without the project id the page still builds — it renders an
# empty state rather than failing.
NEXT_PUBLIC_SANITY_PROJECT_ID=0z2uy7z3
NEXT_PUBLIC_SANITY_DATASET=production

# This one IS a secret and stays empty here. Only needed if the dataset is made
# private, or to preview unpublished drafts. Server-side only — never prefix it
# with NEXT_PUBLIC_, which would publish it to every visitor.
SANITY_API_READ_TOKEN=
